const money=v=>Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const escapeHtml=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;min'}[c]));
function category(s){s=s.toUpperCase();if(s.includes('TRAVEL')||s.includes('KIT ')||s.includes('LIGHT PACK'))return 'Kits e Travel';if(s.includes('INTERDENTAL')||s.includes('CPS '))return 'Interdentais';if(s.includes('DENTIFRICIO')||s.includes('CREME DENTAL')||s.includes('BE YOU'))return 'Creme dental';if(s.includes('ESCOVA')||s.includes('CS ')||s.includes('KIDS')||s.includes('EDITION'))return 'Escovas';return 'Outros'}
const qty=JSON.parse(localStorage.getItem('curaprox_qty_v1')||'{}');
const $=id=>document.getElementById(id);
function render(){
  let q=$('search').value.toLowerCase(),f=$('filter').value;
  let shown=products.filter(p=>(f==='all'||category(p.description)===f)&&[p.description,p.ean,p.dun,p.code].join(' ').toLowerCase().includes(q));
  $('count').textContent=`${shown.length} produtos`;
  $('products').innerHTML=shown.map(p=>{
    let n=qty[p.ean]||0;
    let imgPath=p.image || `assets/${p.code}.jpg`;
    return `<article class="product"><div class="photo"><img src="${imgPath}" alt="${escapeHtml(p.description)}" onerror="this.onerror=null;this.parentElement.innerHTML='<div class=\'placeholder\'><strong>+</strong>Foto indisponível<br><span>${escapeHtml(imgPath)}</span></div>';"><div class="upload" style="font-size:9px;opacity:0.8">Cód: ${p.code}</div></div><div class="product-body"><div class="category">${category(p.description)}</div><div class="name">${escapeHtml(p.description)}</div><div class="codes">EAN: ${p.ean}<br>DUN: ${escapeHtml(p.dun)}<br>Cód.: ${escapeHtml(p.code)}</div><div class="price">${money(p.cost)}</div><div class="small">Custo unitário · Preço sugerido: ${money(p.suggested)}</div><div class="buy"><input aria-label="Quantidade ${escapeHtml(p.description)}" class="qty" type="number" min="0" step="1" value="${n}" data-qty="${p.ean}"><span class="subtotal" data-sub="${p.ean}">${money(n*p.cost)}</span></div></div></article>`
  }).join('');
  updateCart()
}
function updateCart(){let selected=products.filter(p=>(qty[p.ean]||0)>0),total=selected.reduce((a,p)=>a+qty[p.ean]*p.cost,0);$('cart-items').innerHTML=selected.length?selected.map(p=>`<div class="cart-line"><span>${escapeHtml(p.description)}<br><small>${qty[p.ean]} × ${money(p.cost)}</small></span><b>${money(qty[p.ean]*p.cost)}</b></div>`).join(''):'<p class="muted">Nenhum produto selecionado.</p>';$('total').textContent=money(total);$('floating-total').textContent=money(total);$('minimum').textContent=total>0&&total<3000?'Referência comercial: pedido mínimo de R$ 3.000,00. Confirme a condição vigente.':'';return {selected,total}}
$('products').addEventListener('input',e=>{let id=e.target.dataset.qty;if(!id)return;qty[id]=Math.max(0,Math.floor(Number(e.target.value)||0));localStorage.setItem('curaprox_qty_v1',JSON.stringify(qty));let p=products.find(x=>x.ean===id),sub=document.querySelector(`[data-sub="${id}"]`);if(sub)sub.textContent=money(qty[id]*p.cost);updateCart()});
$('search').addEventListener('input',render);$('filter').addEventListener('change',render);
function customer(){return {company:$('company').value.trim(),cnpj:$('cnpj').value.trim(),contact:$('contact').value.trim(),notes:$('notes').value.trim()}}
function message(){let {selected,total}=updateCart(),c=customer();if(!selected.length){alert('Selecione pelo menos um produto.');return null}return `*PEDIDO CURAPROX - FARMÁCIA 2026*\nCliente: ${c.company||'Não informado'}\nCNPJ: ${c.cnpj||'Não informado'}\nContato: ${c.contact||'Não informado'}\n\n`+selected.map(p=>`${p.description}\nEAN: ${p.ean} | DUN: ${p.dun}\n${qty[p.ean]} un. × ${money(p.cost)} = ${money(qty[p.ean]*p.cost)}`).join('\n\n')+`\n\n*TOTAL: ${money(total)}*\nObservações: ${c.notes||'Nenhuma'}\nValores sujeitos à confirmação comercial.`}
$('whatsapp').onclick=()=>{let m=message();if(m)window.open('https://wa.me/?text='+encodeURIComponent(m),'_blank','noopener,noreferrer')};$('csv').onclick=()=>{let {selected,total}=updateCart();if(!selected.length)return alert('Selecione produtos antes de baixar.');let c=customer(),rows=[['Cliente',c.company],['CNPJ',c.cnpj],['Contato',c.contact],['Observações',c.notes],[],['EAN','DUN','Código','Descrição','Custo unitário (R$)','Quantidade','Total (R$)'],...selected.map(p=>[p.ean,p.dun,p.code,p.description,p.cost.toFixed(2).replace('.',','),qty[p.ean],(qty[p.ean]*p.cost).toFixed(2).replace('.',',')]),[],['','','','','','TOTAL',total.toFixed(2).replace('.',',')]];let csv='\ufeff'+rows.map(r=>r.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(';')).join('\r\n');let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));a.download='Pedido_CURAPROX_Farmacia_2026.csv';a.click();URL.revokeObjectURL(a.href)};
$('print').onclick=()=>{let m=message();if(!m)return;let w=window.open('','_blank');if(!w)return alert('Permita janelas pop-up para imprimir.');w.document.write('<!doctype html><html><head><meta charset="utf-8"><title>Pedido CURAPROX</title><style>body{font:14px Arial;padding:32px;white-space:pre-wrap;line-height:1.5}</style></head><body>'+escapeHtml(m)+'</body></html>');w.document.close();w.focus();w.print()};$('clear').onclick=()=>{if(confirm('Deseja zerar todas as quantidades?')){Object.keys(qty).forEach(k=>delete qty[k]);localStorage.removeItem('curaprox_qty_v1');render()}};
render();</script></body></html>
